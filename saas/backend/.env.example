# Database
DATABASE_URL=sqlite:///./mailpilot.db

# Auth
JWT_SECRET_KEY=change-this-to-a-random-string

# Email Providers (OAuth)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback

# Meta WhatsApp (shared SaaS credentials)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# AI Provider (openai, anthropic, google)
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEFAULT_AI_MODEL=gpt-4o-mini

# Application
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
